msgstr "%s (ausente)"

msgid "Save Skin and Clips"
msgstr "Salvar skin e clips"

msgid "Pixel Preview"
msgstr "Prévia em pixels"

msgid "Flip"
msgstr "Espelhar"

msgid "Face left."
msgstr "Vira para a esquerda (espelhado)."

msgid "Where it looks (the model turns)."
msgstr "Para onde olha (o modelo gira)."

msgid "The palette its recolored meshes take."
msgstr "A paleta que as malhas recoloridas recebem."

msgid "No Palette"
msgstr "Sem paleta"
